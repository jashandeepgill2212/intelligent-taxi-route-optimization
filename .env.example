# TaxiRoute RL Environment Configuration

# Backend API Settings
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Settings (Optional PostgreSQL / PostGIS, defaults to SQLite)
DATABASE_URL=sqlite:///./taxiroute.db
USE_POSTGRES=false

# Machine Learning & Graph Settings
OSM_CACHE_DIR=./ml/data/osm_cache
DEFAULT_CITY=Ludhiana, India
MODEL_CHECKPOINT_DIR=./ml/checkpoints
DQN_MODEL_PATH=./ml/checkpoints/dqn_model.pt

# Frontend Settings (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
